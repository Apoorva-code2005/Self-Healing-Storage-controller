# MinIO root credentials for local development
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MinIO node endpoints (bound to 127.0.0.1)
NODE_1_ENDPOINT=http://127.0.0.1:9001
NODE_2_ENDPOINT=http://127.0.0.1:9002
NODE_3_ENDPOINT=http://127.0.0.1:9003

# Application configuration
CONFIG_PATH=config/default.yaml
APP_HOST=127.0.0.1
APP_PORT=8000
